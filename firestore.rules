rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function game(gameCode) {
      return get(/databases/$(database)/documents/games/$(gameCode)).data;
    }

    function gameOwner(gameCode) {
      return game(gameCode).teacherUid;
    }

    function gameStatus(gameCode) {
      return game(gameCode).status;
    }

    function gameCurrentIndex(gameCode) {
      return game(gameCode).currentQuestionIndex;
    }

    // 일시정지 여부. 필드가 없는 예전 게임은 false(진행 중)로 취급한다.
    function gamePaused(gameCode) {
      return game(gameCode).get('paused', false) == true;
    }

    // The owner of a room. A teacher may own many rooms (rooms are keyed by a
    // roomId, not by uid). Legacy/primary rooms predate ownerUid and live at
    // rooms/{uid}, so default to the doc id — which equals the owner uid there.
    function roomOwner(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.get('ownerUid', roomId);
    }

    // ---- Teacher rooms (1 teacher : N rooms) + per-room question bank ----
    match /rooms/{roomId} {
      // single-doc read. The primary room slot (rooms/{uid}) is allowed by doc
      // id so a fresh teacher can read-before-create it while it doesn't exist
      // yet (a rule touching resource.data would error on the null resource).
      // Additional (random-id) rooms are readable only when they exist and the
      // caller owns them.
      allow get: if isSignedIn() && (
        roomId == request.auth.uid
        || (resource != null && resource.data.ownerUid == request.auth.uid)
      );
      // list/query: MUST use a direct field reference. The room list runs
      // where('ownerUid','==',uid); Firestore statically checks that the query
      // is safe against the rule, and a .get() with a default is opaque to that
      // check (it rejects the whole query). Rooms without ownerUid simply don't
      // match the filter, so this never leaks another teacher's rooms.
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.get('ownerUid', roomId) == request.auth.uid
        // ownership is immutable: block re-pointing a room at another teacher
        // (which would inject it into their room list). The default handles the
        // legacy backfill where ownerUid goes absent(→roomId) → roomId.
        && request.resource.data.get('ownerUid', roomId) == resource.data.get('ownerUid', roomId);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // owner may delete their room (the client removes questionBank + roomCode
      // first, then the room doc)
      allow delete: if isSignedIn()
        && resource.data.get('ownerUid', roomId) == request.auth.uid;

      // correctChoiceId lives here, so only the room owner may ever read it
      match /questionBank/{questionId} {
        allow read: if isSignedIn() && roomOwner(roomId) == request.auth.uid;

        // the teacher is their own reviewer, so their own questions go straight
        // to 'approved'; anything a student submits is forced into 'pending'.
        // A student create is additionally rejected once 제출 종료 is set — the
        // room's submissionOpen must not be false (get default true keeps
        // pre-existing rooms open). The owner's own creation is never gated.
        allow create: if isSignedIn() && (
          (
            roomOwner(roomId) == request.auth.uid
            && request.resource.data.createdBy == 'teacher'
            && request.resource.data.status == 'approved'
          )
          || (
            roomOwner(roomId) != request.auth.uid
            && request.resource.data.createdBy == 'student'
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.get('submissionOpen', true) == true
          )
        );

        // approve/reject/edit is the room owner's call only
        allow update, delete: if isSignedIn() && roomOwner(roomId) == request.auth.uid;
      }
    }

    // room-code -> room lookup, so students can resolve a room without ever
    // knowing the teacher's uid (mirrors the game-code pattern below). teacherUid
    // is the owner (keeps these rules uid-based); roomId is which room it points
    // at (equal to teacherUid for a primary room; legacy docs may omit it).
    match /roomCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.teacherUid
        && request.resource.data.keys().hasOnly(['teacherUid', 'roomId', 'submissionOpen'])
        && !exists(/databases/$(database)/documents/roomCodes/$(code));
      // the owning teacher may toggle submissionOpen (제출 종료/열기); no other
      // field may change
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.teacherUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissionOpen']);
      // owner may delete the code when deleting its room
      allow delete: if isSignedIn() && request.auth.uid == resource.data.teacherUid;
    }

    // ---- Ephemeral game sessions, looked up directly by game code ----
    match /games/{gameCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow delete: if false;

      // one-shot nickname reservation to block duplicate nicknames in a game
      match /nicknames/{slug} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['playerUid'])
          && request.resource.data.playerUid == request.auth.uid
          && !exists(/databases/$(database)/documents/games/$(gameCode)/nicknames/$(slug));
        allow update: if false;
        allow delete: if isSignedIn()
          && request.auth.uid == gameOwner(gameCode)
          && gameStatus(gameCode) == 'lobby';
      }

      match /players/{playerUid} {
        allow create: if isSignedIn() && request.auth.uid == playerUid;

        // the roster is public in the lobby (just nicknames, no scores yet)
        // and once results are revealed; during active play, players only
        // see themselves and the host so live scores/streaks aren't visible
        allow read: if isSignedIn() && (
          request.auth.uid == playerUid
          || request.auth.uid == gameOwner(gameCode)
          || gameStatus(gameCode) == 'lobby'
          || gameStatus(gameCode) == 'finished'
        );

        // only the host grades / updates score + streak
        allow update: if isSignedIn() && request.auth.uid == gameOwner(gameCode);
        allow delete: if isSignedIn()
          && request.auth.uid == gameOwner(gameCode)
          && gameStatus(gameCode) == 'lobby';

        match /answers/{questionIndex} {
          // a player submits their own answer exactly once, ungraded
          allow create: if isSignedIn()
            && request.auth.uid == playerUid
            && request.resource.data.keys().hasOnly(['choiceId', 'answeredAt', 'isCorrect', 'pointsEarned'])
            && request.resource.data.isCorrect == null
            && request.resource.data.pointsEarned == null
            && gameStatus(gameCode) == 'active'
            && !gamePaused(gameCode)
            && int(questionIndex) == gameCurrentIndex(gameCode);

          allow read: if isSignedIn() && (
            request.auth.uid == playerUid
            || request.auth.uid == gameOwner(gameCode)
          );

          // host grades it once; the verdict can't be changed after the fact
          allow update: if isSignedIn()
            && request.auth.uid == gameOwner(gameCode)
            && resource.data.isCorrect == null;

          allow delete: if false;
        }
      }
    }
  }
}
